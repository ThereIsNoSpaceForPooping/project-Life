# ============================================
# LLM API 配置
# ============================================
# MiniMax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# 通义千问（DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认 LLM 提供商（minimax / dashscope）
DEFAULT_PROVIDER=dashscope

# ============================================
# 应用配置
# ============================================
APP_NAME=LangGraph Agent Demo
APP_ENV=development
LOG_LEVEL=INFO

# ============================================
# Agent 配置
# ============================================
# 默认温度（0.0 - 2.0）
TEMPERATURE=0.7

# Agent 最大思考轮数
MAX_ITERATIONS=10

# ============================================
# 人机协作配置
# ============================================
# 是否启用人工审核（工具调用前暂停等待确认）
# true: 启用（适合生产环境）
# false: 关闭（适合开发测试）
ENABLE_HUMAN_REVIEW=false

# ============================================
# 记忆配置
# ============================================
# 记忆后端（memory / sqlite）
# memory: 内存模式，进程重启后丢失（开发用）
# sqlite: SQLite 持久化，进程重启后保留（生产用）
MEMORY_BACKEND=memory

# SQLite 数据库路径（仅 MEMORY_BACKEND=sqlite 时生效）
SQLITE_DB_PATH=data/memory.db

# ============================================
# 工具配置
# ============================================
# 是否使用真实 API（true / false）
USE_REAL_API=true

# 和风天气 API Key（免费申请: https://dev.qweather.com/）
WEATHER_API_KEY=

# 网络搜索最大结果数
SEARCH_MAX_RESULTS=5
